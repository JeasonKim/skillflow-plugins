{
  "schemaVersion": 2,
  "marketplaceName": "jeasonkim-plugins",
  "type": "expert",
  "targetMarketplace": "my-experts",
  "branch": "main",
  "plugins": [
    "wf-mrk3toat216b141c"
  ],
  "mcp": {
    "source": "expert-plugin-manifest",
    "connectionMode": "custom-mcp",
    "launchPathMode": "self-locating",
    "unresolvedVariablePolicy": "reject",
    "requiredTools": [
      "render_workflow_dashboard_widget",
      "create_task",
      "start_task",
      "complete_node"
    ]
  },
  "installation": {
    "targetDirectory": "$WORKBUDDY_CONFIG_DIR/plugins/marketplaces/my-experts/plugins",
    "enabledPluginKey": "<plugin-code>@my-experts",
    "mergeMcpServersVerbatim": true,
    "requiresRestart": true,
    "requiresNewSession": true
  }
}
